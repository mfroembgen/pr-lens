{
  "name": "pr-lens",
  "version": "0.0.0",
  "private": true,
  "description": "Review what actually matters \u2014 PR diffs as animated, interactive diagrams inside the GitHub pull request.",
  "license": "MIT",
  "author": "Coldtea AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coldteadotai/pr-lens.git"
  },
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "bun --bun run --filter './packages/*' --if-present build",
    "compile:cli": "bun build packages/cli/src/bin.ts --compile --minify --sourcemap --outfile=dist/cli/pr-lens",
    "typecheck": "bun run --filter './packages/*' --if-present typecheck",
    "test": "bun run --filter './packages/*' --if-present test",
    "schema:emit": "bun run --filter @coldtea/pr-lens-schema schema:emit",
    "skill:sync": "bun run --filter @coldtea/pr-lens-agent-skill skill:sync",
    "release:cli": "bun run verify && cd packages/cli && bun publish --access public",
    "verify": "bun run build && bun run typecheck && bun run test && bun run test:chart",
    "build:canvas": "bun --bun run --filter '@coldtea/pr-lens-canvas-local...' build",
    "test:browser": "bun run --filter @coldtea/pr-lens-canvas-local test:browser",
    "test:chart": "bun test charts/pr-lens/tests"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929"
  },
  "workspaces": [
    "packages/*"
  ],
  "trustedDependencies": [
    "esbuild"
  ]
}
